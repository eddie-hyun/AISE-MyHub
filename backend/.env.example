# Supabase Postgres connection (Settings > Connect > Session pooler)
DB_HOST=aws-0-xxxxxxxxxxxx.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=your-db-password

# Admin login (Step 4)
ADMIN_PASSCODE=your-admin-passcode
SESSION_SECRET=generate-with-python-c-import-secrets-print-secrets-token-hex-32
